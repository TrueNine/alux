{
  "name": "alux",
  "version": "0.0.28",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "pi": {
    "extensions": [
      "./.pi-plugin/index.ts"
    ],
    "skills": [
      "./skills/shared"
    ]
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./.cline-plugin/index.ts"
        ],
        "capabilities": [
          "hooks",
          "skills",
          "mcp"
        ]
      }
    ]
  },
  "exports": {
    ".": "./.opencode-plugin/index.ts",
    "./server": "./.opencode-plugin/index.ts"
  },
  "peerDependencies": {
    "@cline/sdk": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@opencode/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path || echo '[alux] lefthook unavailable; skipped git hooks'",
    "postinstall": "(lefthook install --reset-hooks-path || echo '[alux] lefthook unavailable; skipped git hooks') && (bun run sync:skills || echo '[alux] shared skill sync skipped - bun unavailable or failed') && (bun run sync:rules || echo '[alux] shared rule sync skipped - bun unavailable or failed')",
    "sync:skills": "bun scripts/mixining-shared-skills-to-native-skills.ts",
    "sync:rules": "bun scripts/mixing-shared-rules-to-native-rules.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest watch",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:coverage:watch": "bun --bun vitest watch --coverage",
    "test:mutation": "stryker run",
    "lint": "biome check .",
    "lint:fix": "biome lint --write .",
    "list:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check:typescript": "tsc --noEmit",
    "check:typescript:fix": "biome check --write . && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cline/sdk": "0.0.82",
    "@cucumber/cucumber": "^13.2.1",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@fast-check/vitest": "^0.4.1",
    "@opencode/plugin": "2.3.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/bun": "^1.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.9.0",
    "lefthook": "2.1.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "zx": "^8.8.5"
  },
  "type": "module"
}

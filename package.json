{
	"name": "alux",
	"version": "0.0.7",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"prepare": "husky",
		"postinstall": "husky && bun run sync:skills",
		"sync:skills": "bun scripts/mixining-shared-skills-to-native-skills.ts",
		"lint": "biome check .",
		"lint:fix": "biome lint --write .",
		"list:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check:typescript": "tsc --noEmit",
		"check:typescript:fix": "biome check --write . && tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@fast-check/vitest": "^0.4.1",
		"@types/bun": "^1.4.0",
		"fast-check": "^4.9.0",
		"husky": "^9.1.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}

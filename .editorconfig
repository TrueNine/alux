root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
tab_width = 2
max_line_length = 200
indent_style = space
insert_final_newline = true

[*.md]
charset = utf-8
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = unset
max_line_length = off
tab_width = unset
trim_trailing_whitespace = false

[*.toon]
indent_size = 1
tab_width = 1

[Makefile]
indent_style = tab

[.gitmodules]
indent_style = tab

[.gitconfig]
indent_style = tab

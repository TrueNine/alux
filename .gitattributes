# Auto-detect text files and normalize line endings to LF.
* text=auto eol=lf

# Text files must be UTF-8 in both the working tree and Git index.
*.bat text working-tree-encoding=UTF-8 eol=lf
*.bash text working-tree-encoding=UTF-8 eol=lf

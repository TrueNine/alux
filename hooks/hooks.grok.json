{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${GROK_PLUGIN_ROOT}/hooks/session-start/sync-agent-instructions.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${GROK_PLUGIN_ROOT}/hooks/pre-tool-use/rtk-pre-tool-use.ts\" --grok",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${GROK_PLUGIN_ROOT}/hooks/post-tool-use/rtk-post-tool-use.ts\" --grok"
          }
        ]
      }
    ]
  }
}
